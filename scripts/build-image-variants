#!/usr/bin/env bash
# Build responsive JPEG + WebP variants for published photographs and
# regenerate _data/images.yml (intrinsic size, orientation, variant widths).
#
#   ./scripts/build-image-variants          # only new or changed sources
#   ./scripts/build-image-variants --force  # rebuild every variant
#
# Sources:  assets/images/photography/**/*.{jpg,jpeg}  (already watermarked)
# Variants: assets/images/variants/<same path>-<width>.{jpg,webp}
# Sources are never upscaled; the largest variant is min(source width, 2000).
# When the source is no wider than 2000px, the source JPEG itself is the
# largest JPEG candidate (source_is_largest: true) and only WebP is written.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SRC_DIR="$ROOT/assets/images/photography"
OUT_DIR="$ROOT/assets/images/variants"
DATA="$ROOT/_data/images.yml"
WIDTHS=(480 1200 2000)
JPEG_QUALITY=82
WEBP_QUALITY=80

if ! command -v magick >/dev/null 2>&1; then
  echo "Need ImageMagick (magick) to build image variants." >&2
  exit 1
fi

force=0
for arg in "$@"; do
  case "$arg" in
    --force) force=1 ;;
    -h|--help)
      echo "Usage: $0 [--force]"
      exit 0
      ;;
    *)
      echo "Unknown option: $arg" >&2
      exit 1
      ;;
  esac
done

export FONTCONFIG_CACHE="${TMPDIR:-/tmp}/fontconfig-cache"
mkdir -p "$FONTCONFIG_CACHE" "$OUT_DIR"

needs_build() {
  [[ "$force" -eq 1 || ! -f "$2" || "$1" -nt "$2" ]]
}

tmp_data="$(mktemp)"
{
  echo "# Generated by scripts/build-image-variants — do not edit by hand."
} > "$tmp_data"

count=0
built=0

while IFS= read -r src; do
  [[ -n "$src" ]] || continue
  rel="${src#"$SRC_DIR/"}"
  stem="${rel%.*}"
  base="$OUT_DIR/$stem"
  mkdir -p "$(dirname "$base")"

  read -r w h < <(magick identify -format '%w %h\n' "$src[0]" | head -n 1)

  if (( w * 100 > h * 105 )); then
    orientation="landscape"
  elif (( h * 100 > w * 105 )); then
    orientation="portrait"
  else
    orientation="square"
  fi

  largest=$(( w < 2000 ? w : 2000 ))
  widths=()
  for target in "${WIDTHS[@]}"; do
    (( target < largest )) && widths+=("$target")
  done
  widths+=("$largest")

  for vw in "${widths[@]}"; do
    jpg="$base-$vw.jpg"
    webp="$base-$vw.webp"
    # At full source width the original JPEG is served as-is; only WebP is added.
    if (( vw < w )) && needs_build "$src" "$jpg"; then
      magick "$src[0]" -auto-orient -resize "${vw}x>" -strip \
        -sampling-factor 4:2:0 -interlace JPEG -quality "$JPEG_QUALITY" \
        -set comment "watermarked" "$jpg"
      built=$((built + 1))
    fi
    if needs_build "$src" "$webp"; then
      magick "$src[0]" -auto-orient -resize "${vw}x>" -strip \
        -quality "$WEBP_QUALITY" -define webp:method=6 "$webp"
      built=$((built + 1))
    fi
  done

  # Height of the largest variant keeps width/height attributes exact.
  vh=$(( (h * largest + w / 2) / w ))
  {
    echo "\"/assets/images/photography/$rel\":"
    echo "  width: $largest"
    echo "  height: $vh"
    echo "  orientation: $orientation"
    echo "  base: /assets/images/variants/$stem"
    echo "  widths: [$(IFS=,; echo "${widths[*]}" | sed 's/,/, /g')]"
    echo "  source_is_largest: $([[ "$largest" -eq "$w" ]] && echo true || echo false)"
  } >> "$tmp_data"
  count=$((count + 1))
done < <(find "$SRC_DIR" -type f \( -iname '*.jpg' -o -iname '*.jpeg' \) | LC_ALL=C sort)

mv "$tmp_data" "$DATA"
echo "Done. $count source(s), $built file(s) written. Data: ${DATA#"$ROOT/"}"

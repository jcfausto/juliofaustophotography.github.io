#!/usr/bin/env bash
# Burn a corner copyright into published photography JPEGs and embed the
# rights metadata: EXIF Artist/Copyright, IPTC, and the XMP block in
# scripts/copyright.xmp (creator, rights, licence URL, AI-training opt-out).
#
#   ./scripts/watermark-photos            # collections only
#   ./scripts/watermark-photos --journal  # also field note images
#   ./scripts/watermark-photos --essays   # also essay images
#   ./scripts/watermark-photos <folder>…  # only these folders
#   ./scripts/watermark-photos --retag …  # rewrite metadata on marked files
#
# The --journal folder also holds product shots and third-party images, so
# prefer marking a single note's folder: everything selected is claimed as
# Julio's work.
#
# Files already marked (JPEG comment "watermarked") are not marked again;
# they only get the metadata if it is missing. Replaces any existing XMP.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PHOTO="$ROOT/assets/images/photography"
XMP="$ROOT/scripts/copyright.xmp"
OWNER="Julio Cesar Fausto"
TEXT="© $OWNER"
NOTICE="© $OWNER. All rights reserved."
# EXIF text fields are ASCII.
EXIF_NOTICE="Copyright $OWNER. All rights reserved."
FLAG="watermarked"

COLLECTIONS=(
  woodlands-and-landscapes
  architectural-and-cityscapes
  nature-and-animal-life
)

if ! command -v magick >/dev/null 2>&1; then
  echo "Need ImageMagick (magick) to watermark photos." >&2
  exit 1
fi

if ! command -v exiftool >/dev/null 2>&1; then
  echo "Need ExifTool (exiftool) to embed copyright metadata." >&2
  exit 1
fi

export FONTCONFIG_CACHE="${TMPDIR:-/tmp}/fontconfig-cache"
mkdir -p "$FONTCONFIG_CACHE"

include_journal=0
include_essays=0
retag=0
folders=()
for arg in "$@"; do
  case "$arg" in
    --journal) include_journal=1 ;;
    --essays) include_essays=1 ;;
    --retag) retag=1 ;;
    -h|--help)
      echo "Usage: $0 [--retag] [--journal] [--essays] | <folder>…"
      exit 0
      ;;
    -*)
      echo "Unknown option: $arg" >&2
      exit 1
      ;;
    *)
      if [[ ! -d "$arg" ]]; then
        echo "Not a folder: $arg" >&2
        exit 1
      fi
      folders+=("$arg")
      ;;
  esac
done

already_marked() {
  local comment
  comment="$(magick identify -format '%c' "$1" 2>/dev/null || true)"
  [[ "$comment" == *"$FLAG"* ]]
}

already_tagged() {
  [[ "$(exiftool -s3 -EXIF:Copyright -ThumbnailImage -PhotoshopThumbnail "$1" 2>/dev/null)" == "$EXIF_NOTICE" ]]
}

# The Photoshop block and EXIF IFD1 hold export-time thumbnails that predate
# the watermark, so they are dropped.
tag() {
  exiftool -q -overwrite_original \
    -Photoshop:all= \
    -IFD1:all= \
    "-XMP<=$XMP" \
    -EXIF:Artist="$OWNER" \
    -EXIF:Copyright="$EXIF_NOTICE" \
    -IPTC:CodedCharacterSet=UTF8 \
    -IPTC:By-line="$OWNER" \
    -IPTC:CopyrightNotice="$NOTICE" \
    "$1"
}

watermark() {
  local src="$1"
  local w h short pointsize pad tmp

  w="$(magick identify -format '%w' "$src")"
  h="$(magick identify -format '%h' "$src")"
  if [[ "$w" -lt "$h" ]]; then short="$w"; else short="$h"; fi

  pointsize="$(python3 -c "print(max(14, int($w * 0.022)))")"
  pad="$(python3 -c "print(max(10, int($short * 0.015)))")"

  tmp="${src}.watermark-tmp.jpg"
  magick "$src" \
    -gravity southeast \
    -pointsize "$pointsize" \
    -fill "rgba(0,0,0,0.40)" \
    -annotate "+$((pad + 1))+$((pad + 1))" "$TEXT" \
    -fill "rgba(255,255,255,0.78)" \
    -annotate "+${pad}+${pad}" "$TEXT" \
    -set comment "$FLAG" \
    -quality 88 \
    "$tmp"
  mv "$tmp" "$src"
}

collect_files() {
  local dir="$1"
  [[ -d "$dir" ]] || return 0
  find "$dir" -type f \( -iname '*.jpg' -o -iname '*.jpeg' \) | sort
}

files=()
if [[ "${#folders[@]}" -gt 0 ]]; then
  for dir in "${folders[@]}"; do
    while IFS= read -r f; do
      [[ -n "$f" ]] && files+=("$(cd "$(dirname "$f")" && pwd)/$(basename "$f")")
    done < <(collect_files "$dir")
  done
else
  for slug in "${COLLECTIONS[@]}"; do
    while IFS= read -r f; do
      [[ -n "$f" ]] && files+=("$f")
    done < <(collect_files "$PHOTO/$slug")
  done
fi

if [[ "$include_journal" -eq 1 ]]; then
  while IFS= read -r f; do
    [[ -n "$f" ]] && files+=("$f")
  done < <(collect_files "$PHOTO/journal")
fi

if [[ "$include_essays" -eq 1 ]]; then
  while IFS= read -r f; do
    [[ -n "$f" ]] && files+=("$f")
  done < <(collect_files "$PHOTO/essays")
fi

if [[ "${#files[@]}" -eq 0 ]]; then
  echo "No JPEGs found under $PHOTO"
  exit 0
fi

echo "Watermarking ${#files[@]} photo(s)…"
marked=0
tagged=0
skipped=0
failed=0

for src in "${files[@]}"; do
  rel="${src#"$ROOT/"}"
  if already_marked "$src"; then
    if [[ "$retag" -eq 0 ]] && already_tagged "$src"; then
      echo "  skip  $rel"
      skipped=$((skipped + 1))
    elif tag "$src"; then
      echo "  tag   $rel"
      tagged=$((tagged + 1))
    else
      echo "  fail  $rel" >&2
      failed=$((failed + 1))
    fi
    continue
  fi
  if watermark "$src" && tag "$src"; then
    echo "  mark  $rel"
    marked=$((marked + 1))
  else
    echo "  fail  $rel" >&2
    failed=$((failed + 1))
  fi
done

echo "Done. marked $marked, tagged $tagged, skipped $skipped, failed $failed."
if [[ "$failed" -gt 0 ]]; then
  exit 1
fi

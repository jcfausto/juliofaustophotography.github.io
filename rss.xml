---
layout: null
permalink: /rss.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }} — Field Notes</title>
    <link>{{ site.url }}/field-notes/</link>
    <description>{{ site.data.site.field_notes.intro | xml_escape }}</description>
    <language>{{ site.lang | default: "en" }}</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <atom:link href="{{ site.url }}/rss.xml" rel="self" type="application/rss+xml"/>
    {%- assign notes = site.field_notes | sort: "date" | reverse %}
    {%- for post in notes limit: 20 %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ site.url }}{{ post.url }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ post.url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      {%- if post.category %}
      <category>{{ post.category | xml_escape }}</category>
      {%- endif %}
      <description>{{ post.description | default: post.excerpt | strip_html | xml_escape }}</description>
    </item>
    {%- endfor %}
  </channel>
</rss>
